# =============================================================
# Supercell Clash Royale API token
# =============================================================
#
# 9 kisilik bir takimda calisiyoruz, herkesin IP'si farkli.
# Bu yuzden RoyaleAPI'nin ucretsiz proxy hizmetini kullanacagiz.
# Boylece tek bir token ile herkesin makinesinde calisir.
#
# Token nasil alinir:
# 1. https://developer.clashroyale.com adresine git
# 2. Supercell hesabinla giris yap
# 3. "Create New Key" tikla
# 4. Bir isim ver (orn: cr-analyze-team)
# 5. Aciklama yaz (orn: Anti-deck tool — Seeok team)
# 6. IP Addresses kismina SU IP'YI yaz (kendi IP'ni DEGIL):
#
#         45.79.218.79
#
#    Bu RoyaleAPI proxy sunucusunun IP'si. Boylece tum istekler
#    bu IP uzerinden proxy'lenir ve calisir.
# 7. Olusan token'i asagi yapistir.
#
# Sonra: bu dosyayi .env olarak kopyala (cp .env.example .env)
#        ve gercek token'i alta yapistir.
# =============================================================

CR_API_TOKEN=eyJ0eXAiOiJKV1Q...buraya_token_gelecek

# (Opsiyonel) API base URL.
# Varsayilan: RoyaleAPI proxy kullanilir (yukaridaki 45.79.218.79 IP'si gerekir).
# Eger kendi IP'nle token aldiysan ve direct gitmek istiyorsan:
#   CR_API_BASE_URL=https://api.clashroyale.com/v1
# Bos birakirsan proxy kullanilir.
CR_API_BASE_URL=
